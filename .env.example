# Opcional. Sem estas variáveis o app funciona 100% local (IndexedDB no aparelho).
# Com elas, os dados e fotos vão para o Supabase e ficam compartilhados entre aparelhos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Push diário (só no modo Supabase) ─────────────────────────
# Gere o par com:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@dominio.com.br
# Somente no servidor (Vercel). NUNCA com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto aleatório longo; a Vercel envia no header do cron
CRON_SECRET=
